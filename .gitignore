# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
build/
dist/
*.egg-info/
.ruff_cache/
.pytest_cache/

# 抓取/采集产物（本地生成，不进仓库：体积 + 版权）
subs/
corpus_asr/
manifest.json

# 笔记库（`serve` 默认写到当前目录的 notes/）：这是用户自己的知识库，
# 里面是别人视频的正文摘要，和 subs/ 一个性质。
notes/

# 本地服务状态（`serve` 默认在当前目录建库，还带 WAL/SHM 两个旁路文件）
tasks.db
tasks.db-wal
tasks.db-shm
*.sqlite
*.sqlite3

# 真浏览器跑端到端时的工作目录：临时任务库、字幕副本、无头浏览器的 profile
tools/e2e_learn/_work/

# 个人数据 / 凭证
# 别按具体名字一个个列：浏览器插件导出的文件名五花八门——cookies.txt、
# bilibili_cookies.txt、www.bilibili.com_cookies.txt……按后缀统一拦。
# 漏一个的代价是别人的账号进了提交历史，删文件也删不掉。
*cookies.txt

# 转写与音频中间产物
*.m4a
*.wav
*.mp3
*.mp4
*.flv
transcript*.txt

# 系统
.DS_Store
Thumbs.db
